# Local development: leave as /api so Vite proxies to the backend on :8001
# (see vite.config.js). Do not set VITE_API_BASE locally unless you also want
# the dev proxy to point somewhere else.
VITE_API_BASE=/api

# Production (Vercel): the full origin of the deployed backend, including /api
# VITE_API_BASE=https://synapse-backend.onrender.com/api
