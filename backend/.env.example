# Copy to backend/.env for local development. Never commit a filled-in .env.

# ── Required in production ───────────────────────────────────────────────────
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required when ENVIRONMENT=production; a random ephemeral one is used otherwise.
SECRET_KEY=

# Omit for local SQLite (sqlite:///./synapse.db).
# Production: the managed PostgreSQL URL. postgres:// and postgresql:// are
# both accepted and normalised to the psycopg driver automatically.
DATABASE_URL=

# ── CORS (comma separated; must be exact origins, never "*") ────────────────
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Cookies ──────────────────────────────────────────────────────────────────
# Same-origin dev through the Vite proxy: lax + insecure.
# Cross-site production (Vercel -> Render): none + secure.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── Sessions ─────────────────────────────────────────────────────────────────
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# ── Schema management ────────────────────────────────────────────────────────
RUN_MIGRATIONS_ON_STARTUP=false
AUTO_CREATE_TABLES=true

# ── Limits ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=26214400
MAX_JSON_BODY_BYTES=1048576
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=3600
API_RATE_LIMIT=240
API_RATE_WINDOW_SECONDS=60
MAX_FAILED_LOGINS=8
ACCOUNT_LOCK_MINUTES=15

# ── Misc ─────────────────────────────────────────────────────────────────────
ENABLE_DOCS=true
TRUSTED_HOSTS=
